# Deployed AgentPoll contract on BNB Chain mainnet (chain 56).
# Required for the app to load polls or create/vote. When unset (or the zero
# address) the app shows a "contract not deployed yet" state instead of crashing.
NEXT_PUBLIC_AGENT_POLL_ADDRESS=

# WalletConnect Cloud project id (https://cloud.walletconnect.com).
# Optional — without it, only injected wallets (Binance Wallet / MetaMask) are
# offered in the connect menu.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
